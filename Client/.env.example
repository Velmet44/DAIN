# Coordinator the browser reaches. In dev: your PC's HTTP endpoint.
# In production (free Netlify + HTTPS) this MUST be an https:// URL or the
# browser blocks it as mixed content:
#   https://daintest.duckdns.org
VITE_API_URL=http://127.0.0.1:8000

# Default API key prefilled into the key box (user can override; stored in
# localStorage). Keep empty to force entry.
VITE_API_KEY=

# Model selected by default in the chat picker (empty = none / first server model).
VITE_MODEL_ID=

# Default max tokens for the chat box (1..512).
VITE_DEFAULT_MAX_TOKENS=64