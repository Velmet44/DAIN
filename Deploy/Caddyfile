# Caddyfile for DAIN coordinator — automatic HTTPS reverse proxy.
#
# LOCAL DEV (no Caddy needed):
#   Coordinator runs on http://localhost:8000
#   Client dev server on http://localhost:5173/DAIN/
#   Browser connects directly — no HTTPS required for localhost.
#
# PRODUCTION (home PC with DuckDNS):
#  1. Get a free hostname at duckdns.org (e.g. myname.duckdns.org)
#  2. Forward TCP 80 and 443 from your router to this PC
#  3. Update the hostname below
#  4. Start coordinator: uv run python -m dain_coordinator
#  5. Start Caddy: Deploy\caddy.exe run --config Deploy\Caddyfile
#
# The coordinator itself starts separately:
#   cd Coordinator && uv run python -m dain_coordinator

myname.duckdns.org {
    reverse_proxy 127.0.0.1:8000
}
