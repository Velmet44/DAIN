# --- Coordinator ---
DAIN_HOST=0.0.0.0
DAIN_PORT=8000
DAIN_DB_PATH=coordinator.sqlite3
# Shared registration secret: first-time nodes present this to get a per-node token.
# REQUIRED in production — generate one per deployment, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(18))"
# Empty or the well-known default makes the coordinator auto-generate a random
# value at startup (a warning is logged); set it explicitly to keep it stable
# across restarts and to configure nodes with the same value.
DAIN_JOIN_TOKEN=
DAIN_MIN_SCORE=0.05
DAIN_LOG_JSON=0
DAIN_MODEL_STORE_DIR=model_store
# Client API key (sent as X-API-Key / Bearer); REQUIRED in production — generate.
DAIN_API_KEY=
# Admin API key (sent as X-Admin-Key / Bearer); REQUIRED in production — generate.
DAIN_ADMIN_API_KEY=
# CORS origins (comma-separated; "*" opens dev). Lock to your GitHub Pages URL for production:
#   DAIN_CORS_ORIGINS=https://velmet44.github.io
# Rate limit for the public completion API (requests/min/IP; 0 = off).
DAIN_RATE_LIMIT_PER_MIN=60
# LAN coordinator discovery: nodes probe this UDP port (token-authenticated)
# at first startup so they never need a hand-typed coord_url. Set to false on
# a public/WAN coordinator (every node then needs DAIN_COORD_URL explicitly).
DAIN_DISCOVERY_ENABLED=true
DAIN_DISCOVERY_PORT=8456

# --- Node ---
# Base URL only; the agent derives /node/ws and the REST endpoints from it.
DAIN_COORD_URL=ws://localhost:8000
# Must match the coordinator's DAIN_JOIN_TOKEN.
DAIN_JOIN_TOKEN=
DAIN_NODE_ID=
# Persisted identity (node_id + issued token) — keep per node, never commit.
DAIN_NODE_STATE_PATH=node_state.json
DAIN_HEARTBEAT_S=5
# Reported (stub until S10 benchmarking; scoring treats claims as unverified).
DAIN_NET_BW_MBPS=100
DAIN_NET_LAT_MS=50

# --- Models ---
# One of: tinyllama-1.1b | qwen2.5-7b | qwen3-32b | olmoe-1b-7b  (spec §18)
DAIN_MODEL=tinyllama-1.1b

# --- GGUF import (admin page) ---
# Node project the coordinator shells out to for GGUF conversion
# (uv run --project <dir> python -m dain_node.import_gguf). Empty = the
# sibling Node/ directory of the DAIN checkout; set it only for split installs.
DAIN_NODE_PROJECT_DIR=
