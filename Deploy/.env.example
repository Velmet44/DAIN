# --- Coordinator ---
DAIN_HOST=0.0.0.0
DAIN_PORT=8000
DAIN_DB_PATH=coordinator.sqlite3
# Shared registration secret: first-time nodes present this to get a per-node token.
# REQUIRED in production — generate one per deployment, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(18))"
# Empty or the well-known default makes the coordinator auto-generate a random
# value at startup (a warning is logged); set it explicitly to keep it stable
# across restarts and to configure nodes with the same value.
DAIN_JOIN_TOKEN=
DAIN_MIN_SCORE=0.05
DAIN_LOG_JSON=0
DAIN_MODEL_STORE_DIR=model_store
# Client API key (sent as X-API-Key / Bearer); REQUIRED in production — generate.
DAIN_API_KEY=
# Admin API key (sent as X-Admin-Key / Bearer); REQUIRED in production — generate.
DAIN_ADMIN_API_KEY=
# CORS origins (comma-separated; "*" opens dev). Lock to your GitHub Pages URL for production:
#   DAIN_CORS_ORIGINS=https://velmet44.github.io
# Rate limit for the public completion API (requests/min/IP; 0 = off).
DAIN_RATE_LIMIT_PER_MIN=60
# LAN coordinator discovery: nodes probe this UDP port (token-authenticated)
# at first startup so they never need a hand-typed coord_url. Set to false on
# a public/WAN coordinator (every node then needs DAIN_COORD_URL explicitly).
DAIN_DISCOVERY_ENABLED=true
DAIN_DISCOVERY_PORT=8456

# --- Node ---
# Base URL only; the agent derives /node/ws and the REST endpoints from it.
DAIN_COORD_URL=ws://localhost:8000
# Must match the coordinator's DAIN_JOIN_TOKEN.
DAIN_JOIN_TOKEN=
DAIN_NODE_ID=
# Persisted identity (node_id + issued token) — keep per node, never commit.
DAIN_NODE_STATE_PATH=node_state.json
DAIN_HEARTBEAT_S=5
# Reported (stub until S10 benchmarking; scoring treats claims as unverified).
DAIN_NET_BW_MBPS=100
DAIN_NET_LAT_MS=50

# --- Models ---
# One of: tinyllama-1.1b | qwen2.5-7b | qwen3-32b | olmoe-1b-7b  (spec §18)
DAIN_MODEL=tinyllama-1.1b

# --- GGUF import (admin page) ---
# Node project the coordinator shells out to for GGUF conversion
# (uv run --project <dir> python -m dain_node.import_gguf). Empty = the
# sibling Node/ directory of the DAIN checkout; set it only for split installs.
DAIN_NODE_PROJECT_DIR=

# --- Coordinator: serving pool (S22) ---
# Assignment controller: how often desired node portfolios are reconciled.
DAIN_ASSIGNMENT_TICK_S=10
# Replica-first serving: models are assigned whole to the best N nodes; more
# replicas are added when recent demand crosses DAIN_DEMAND_SCALE_THRESHOLD
# arrivals within the 10-minute window. Models too big for any single node are
# planned as pipelines automatically.
DAIN_REPLICAS_PER_MODEL=1
DAIN_MAX_REPLICAS=2
DAIN_DEMAND_SCALE_THRESHOLD=8
# Concurrent replica sessions one node accepts (per-session KV caches).
DAIN_MAX_SESSIONS=4
# How long /v1/completions holds a request (with queued/provisioning status
# frames) while nodes provision or free up, before failing. A completely
# empty pool still fails fast.
DAIN_QUEUE_WAIT_S=30
# Reverse proxy (Caddy/nginx on the same host): peer IPs whose
# X-Forwarded-For header is trusted so the per-IP rate limiter sees real
# client IPs instead of 127.0.0.1. Comma-separated or '*'.
DAIN_TRUSTED_PROXIES=127.0.0.1

# --- Coordinator: placement overcommit ---
# Admit nodes whose free RAM does not cover their stage share (the OS pages
# the excess weights to disk - slow but functional for RAM-short hosts that
# could never fit the model). Default off: placement is refused (HTTP 429).
# DAIN_ALLOW_OVERCOMMIT=false

# --- Node: warm serving tiers (S22) ---
# warm_budget_gb caps resident built-stage memory; warm_models caps how many
# stages stay warm; warm_mode = resident (RAM) | mmap (file-backed, evictable)
# | files (verify+cache only). Provisioning downloads/derives/warms in the
# background BEFORE the node accepts jobs for a model, and a restart never
# re-downloads or re-dequantizes verified files.
DAIN_WARM_BUDGET_GB=3
DAIN_WARM_MODELS=2
DAIN_WARM_MODE=resident
# Concurrent replica sessions this node runs (round-robin interleaved).
DAIN_MAX_SESSIONS=4
# Direct node-to-node activation relay via the peer server. Keep on for nodes
# sharing a LAN; set 0 for NAT'd WAN nodes (the coordinator relay is the
# automatic fallback either way).
DAIN_DIRECT_RELAY=1
